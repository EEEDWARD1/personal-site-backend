# For deployment, set matching production keys as GitHub Actions secrets.
# Do not put real keys in this example file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Optional server-only override, including the /v1 prefix.
# Unset: pnpm dev uses localhost:8080/v1; pnpm start uses the deployed API below.
# API_BASE_URL=https://api.eduardteodor.co.uk/v1
# Docker production uses this public origin, with its production Clerk instance.
CMS_ORIGIN=https://cms.eduardteodor.co.uk
